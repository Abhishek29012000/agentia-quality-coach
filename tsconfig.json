{
  "compilerOptions": {
    "declaration": true,
    "importHelpers": true,
    "module": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "es2022",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["./src/**/*"]
}
