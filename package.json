{
  "name": "agentia-quality-coach",
  "description": "Agentia Quality Coach — story-aware quality gates for Apex, Flow, and LWC CSS",
  "version": "0.1.0",
  "author": "Abhishek Yadav",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "license": "MIT",
  "keywords": [
    "oclif-plugin",
    "agentia",
    "copado",
    "quality-gate",
    "salesforce",
    "lwc",
    "apex",
    "flow"
  ],
  "files": [
    "/dist",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@copado/agentia-plugin-sdk": "^0.1.1"
  },
  "peerDependencies": {
    "@oclif/core": "^4"
  },
  "devDependencies": {
    "@oclif/core": "^4",
    "@types/node": "^22",
    "oclif": "^4",
    "shx": "^0.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "agentia": {
    "hostApi": 1,
    "requires": [
      "auth.status",
      "format.table",
      "work.getWorkItem"
    ],
    "permissions": {
      "network": [],
      "files": "cwd",
      "commands": [],
      "env": []
    }
  },
  "oclif": {
    "bin": "agentia",
    "dirname": "agentia-cli",
    "commands": "./dist/commands",
    "topics": {
      "quality": {
        "description": "Agentia Quality Coach — Apex, Flow, and LWC quality gates"
      }
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "clean": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest",
    "postpack": "npm run clean"
  }
}
